    <!-- Fixed camera high above the south side, looking north and down at the building. -->
    <model name="patrol_cam">
      <static>true</static>
      <pose>7.0 -8.9 19.8 0 1.1 1.5708</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>60</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
